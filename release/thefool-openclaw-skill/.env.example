# 默认连接当前线上服务器
AGENT_SERVER_URL=http://47.103.197.124:5660
XTION_SERVER=http://47.103.197.124:5660

# 必填：用户自己的 player / control key
# 只要填好这两个 key，就可以直接对 OpenClaw 说“加入活动”
AGENT_API_KEY=
AGENT_CONTROL_API_KEY=

# 可选：如果要启用 director，再填写 director key
XTION_DIRECTOR_API_KEY=
XTION_DIRECTOR_AGENTS=qianzi,paopao,jiajia

# 可选：runner 身份覆盖
AGENT_NAME=
AGENT_ID=
AGENT_ROLE=agent_player

# 可选：接 OpenClaw / 自定义 brain 时填写
# 如果先不接自定义 brain，也可以直接用 runner fallback 加入活动
AGENT_BRAIN_COMMAND=python
AGENT_BRAIN_ARGS_JSON=["./bridge/openclaw_bridge.py"]

# 可选：时序参数
AGENT_BRAIN_TIMEOUT_MS=20000
AGENT_BRAIN_RESTART_DELAY_MS=3000
AGENT_CONTROL_STATUS_INTERVAL=15000
XTION_WAKEUP_THRESHOLD_MS=60000
XTION_DIRECTOR_SYNC_INTERVAL_MS=45000
XTION_BRAIN_RELEASE_THRESHOLD_MS=240000
